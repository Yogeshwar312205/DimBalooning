# ==============================================================================
# DimBalooning PDF & Vision AI Service Environment Configuration
# ==============================================================================

# Google Gemini API Key (Recommended - Free Tier available via Google AI Studio)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Optional fallback / high-rate alternative)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Vision Model Preference: "gemini-1.5-flash" (default), "gemini-2.0-flash", or "groq"
VISION_MODEL=gemini-1.5-flash

# Concurrency & Semaphore settings
CONCURRENCY_LIMIT=3

# Service Port
PORT=8001
HOST=0.0.0.0
